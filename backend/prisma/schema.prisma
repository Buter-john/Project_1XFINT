

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}


enum Role {
  EMPLOYE
  MANAGER
  COMPTABILITE
}

model users {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  password        String
  role            Role
  firstConnection Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}